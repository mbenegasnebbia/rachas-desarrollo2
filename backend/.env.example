MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/rachas
PORT=3000

# Firebase Admin: mismo proyecto que Firebase Authentication del cliente.
FIREBASE_PROJECT_ID=
# ADC local: ruta absoluta a un JSON privado guardado FUERA del repositorio.
# Configurar GOOGLE_APPLICATION_CREDENTIALS en el proceso (PowerShell); no pegar el JSON aquí.
# GOOGLE_APPLICATION_CREDENTIALS=

# Arranque sin escrituras automáticas: valores ausentes también deshabilitan.
# Solo el valor exacto true habilita cada comportamiento.
SEED_ENABLED=false
MONGODB_AUTO_INIT_ENABLED=false

# Orígenes permitidos para Socket.IO (separados por coma).
SOCKET_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8080

# Parte IV: releases estables major.minor.patch.
MIN_APP_VERSION=1.0.0
RECOMMENDED_APP_VERSION=1.1.0
# Fecha demostrativa: confirmar el calendario real antes de desplegar.
V1_SUNSET_DATE=2027-06-30T23:59:59Z
# URL pública Web o de distribución, sin tokens ni credenciales.
APP_UPDATE_URL=

# Métricas globales de analytics: UIDs Firebase de operadores, separados por coma.
# Vacío deniega acceso a todos. Nunca colocar tokens aquí.
ANALYTICS_READER_UIDS=
