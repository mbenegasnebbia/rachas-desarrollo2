# Copiar a .env.local y reiniciar con: npx expo start -c
# Emulador de Android (localhost NO es tu PC, 10.0.2.2 sí):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Celular físico con Expo Go: usar la IP de tu PC en la red local
# EXPO_PUBLIC_API_URL=http://192.168.0.X:3000



# Para usar la web:
# EXPO_PUBLIC_API_URL=http://localhost:3000