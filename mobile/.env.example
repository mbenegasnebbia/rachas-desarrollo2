# Copiar a .env.local y reiniciar con: npx expo start -c
# Emulador de Android (localhost NO es tu PC, 10.0.2.2 sí):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Celular físico con Expo Go: usar la IP de tu PC en la red local
# EXPO_PUBLIC_API_URL=http://192.168.0.X:3000
# Para usar la web:
# EXPO_PUBLIC_API_URL=http://localhost:3000


# Firebase Authentication: configuración del cliente web.
# Firebase Console > Configuración del proyecto > Tus apps > Rachas Web.
# Copiar SOLO estas variables al .env/.env.local existente; no reemplazarlo.
# Son identificadores de cliente públicos. Nunca agregar una clave privada/Admin.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
