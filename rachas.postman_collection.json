      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-usuario-id",
            "value": "{{personaA}}"
          }
        ],
        "url": "{{baseUrl}}/desafios/000000000000000000000000"
      }
    },
    {
      "name": "17 Paginación inválida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              ""
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-usuario-id",
            "value": "{{personaA}}"
          }
        ],
        "url": "{{baseUrl}}/desafios?pagina=0&limite=99"
      }
    },
    {
      "name": "18 Cancelar desafío de prueba",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-usuario-id",
            "value": "{{personaA}}"
          }
        ],
        "url": "{{baseUrl}}/desafios/{{desafioId}}/cancelar"
      }
    }
  ]
}
